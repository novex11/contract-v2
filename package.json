{
  "name": "compose",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:testnet": "bash scripts/dev-testnet.sh",
    "manifest:mainnet": "tsx scripts/build-mainnet-manifest.ts",
    "prices:mainnet": "tsx scripts/fetch-mainnet-prices.ts",
    "deploy:mainnet": "bash scripts/deploy-mainnet.sh",
    "deploy:mainnet:fork": "bash scripts/deploy-mainnet.sh --fork",
    "onboard:mainnet": "bash scripts/deploy-mainnet.sh --onboard-only",
    "vaults:mainnet": "bash scripts/deploy-mainnet.sh --vaults-only",
    "sync:mainnet": "node scripts/sync-mainnet-deployments.mjs",
    "mixes:mainnet": "tsx scripts/build-vault-mixes.mts --mainnet",
    "smoke:mainnet": "tsx scripts/mainnet-smoke.ts",
    "keeper:mainnet:dry": "tsx scripts/price-keeper.ts --mainnet --once --dry-run",
    "keeper:testnet": "tsx scripts/price-keeper.ts",
    "keeper:testnet:once": "tsx scripts/price-keeper.ts --once",
    "feeds:refresh:testnet": "tsx scripts/refresh-mock-feeds.ts",
    "smoke:testnet": "tsx scripts/testnet-smoke.ts",
    "smoke:curve:testnet": "tsx scripts/curve-smoke.ts",
    "verify:launched": "tsx scripts/verify-launched-contracts.ts",
    "verify:launched:mainnet": "tsx scripts/verify-launched-contracts.ts --mainnet",
    "verification:export": "bash scripts/export-verification-inputs.sh",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "docker:up": "docker compose up -d --build",
    "docker:up:local-db": "docker compose --profile local-db up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "docker:ps": "docker compose ps",
    "deploy:testnet": "bash scripts/deploy-testnet.sh",
    "sync:testnet": "node scripts/sync-testnet-deployments.mjs",
    "mixes:testnet": "tsx scripts/build-vault-mixes.mts",
    "deploy:testnet:baskets": "bash scripts/deploy-testnet-baskets.sh",
    "smoke:baskets:testnet": "tsx scripts/basket-smoke.ts",
    "deploy:testnet:router": "bash scripts/deploy-testnet-router.sh",
    "deploy:testnet:curve": "bash scripts/deploy-testnet-curve.sh",
    "keeper:mainnet": "tsx scripts/price-keeper.ts --mainnet",
    "keeper:mainnet:once": "tsx scripts/price-keeper.ts --mainnet --once"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "viem": "^2.21.54"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
